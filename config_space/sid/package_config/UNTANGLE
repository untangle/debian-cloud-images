# cloud netplan/systemd-resolved/chrony stack.
PACKAGES purge TRIXIE
chrony
netplan.io
libnss-resolve
systemd-resolved

PACKAGES install-norec UNTANGLE_VENDOR_UNTANGLE
untangle-client-local

PACKAGES install-norec UNTANGLE_LINUX_CONFIG
untangle-linux-config

# Trixie NGFW uses the 6.12 Untangle kernel package.
PACKAGES install-norec TRIXIE
linux-image-6.12.85+3-untangle-amd64
open-vm-tools
